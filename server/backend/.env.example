# /etc/destinyos.env on the droplet (chmod 600). deploy.sh adds SESSION_SECRET, DESTINY_DB and COOKIE_SECURE itself.
ANTHROPIC_API_KEY=sk-ant-...
ALLOWED_ORIGINS=https://destinyos.in,https://www.destinyos.in
CLAUDE_MODEL=claude-sonnet-5
CLAUDE_FAST_MODEL=claude-haiku-4-5-20251001

# Sign-up OTP by SMS (MSG91). Without these the API runs in test mode: codes go to `journalctl -u destinyos-api`.
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# Razorpay (Destiny Plus ₹599/month + add-ons)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_PLAN_ID=
RAZORPAY_WEBHOOK_SECRET=

# WhatsApp Cloud API (daily guidance at 7:00 IST). Without these the daily job is a dry run.
WA_TOKEN=
WA_PHONE_ID=
WA_TEMPLATE=destiny_daily
WA_TEMPLATE_LANG=en

# Limits
FREE_QUESTIONS=3
DAILY_QUESTIONS=30

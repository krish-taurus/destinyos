# /etc/destinyos.env on the droplet (chmod 600). deploy.sh adds SESSION_SECRET, DESTINY_DB and COOKIE_SECURE itself.
ANTHROPIC_API_KEY=sk-ant-...
ALLOWED_ORIGINS=https://destinyos.in,https://www.destinyos.in
CLAUDE_MODEL=claude-sonnet-5
CLAUDE_FAST_MODEL=claude-haiku-4-5-20251001

# Sign-up OTP by SMS (MSG91). Without these the API runs in test mode: codes go to `journalctl -u destinyos-api`.
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# Razorpay (Destiny Plus ₹599/month + add-ons)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_PLAN_ID=
RAZORPAY_WEBHOOK_SECRET=

# WhatsApp Cloud API (daily guidance at 7:00 IST). Without these the daily job is a dry run.
WA_TOKEN=
WA_PHONE_ID=
WA_TEMPLATE=destiny_daily
WA_TEMPLATE_LANG=en

# HALIA: WhatsApp chat and the daily question (replies arrive at https://destinyos.in/api/whatsapp/webhook).
# Meta app → WhatsApp → Configuration: callback URL above, verify token = WA_VERIFY_TOKEN, subscribe to "messages".
WA_NUMBER=                 # the public WhatsApp number in digits, e.g. 9198XXXXXXXX: the QR code opens a chat with it
WA_VERIFY_TOKEN=           # any long random string; paste the same value into Meta
WA_APP_SECRET=             # Meta app → Settings → Basic → App secret (signs inbound messages)
WA_TEMPLATE_QUESTION=halia_question
SITE_URL=https://destinyos.in

# HALIA Chat plan (Razorpay → Subscriptions → Plans → "HALIA Chat", monthly, ₹499)
RAZORPAY_PLAN_ID_CHAT=
HALIA_DAILY_CHATS=25
HALIA_FREE_CHATS=3

# Limits
FREE_QUESTIONS=3
DAILY_QUESTIONS=30

# Admin panel at https://destinyos.in/admin/ (deploy.sh creates this password; keys can then be pasted in the panel instead of here)
ADMIN_EMAIL=
ADMIN_PASSWORD=
